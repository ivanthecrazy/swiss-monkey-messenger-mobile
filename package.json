{
  "name": "swiss-monkey-messenger-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:staging": "tsc && vite build --mode staging",
    "preview": "vite preview",
    "sync": "npm run build && cap sync",
    "sync:staging": "npm run build:staging && cap sync",
    "ios": "npm run build && cap sync ios && cap open ios",
    "ios:staging": "npm run build:staging && cap sync ios && cap open ios",
    "android": "npm run build && cap sync android && cap open android",
    "android:staging": "npm run build:staging && cap sync android && cap open android",
    "assets": "python3 scripts/make-assets.py && npx --yes @capacitor/assets generate --ios --android && python3 scripts/make-notification-icon.py && python3 scripts/make-staging-icons.py"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/lato": "^5.1.0",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.1.0",
    "@rails/actioncable": "^8.0.0",
    "@regimenthq/messenger-core": "^0.1.53",
    "@regimenthq/shell-auth": "^0.2.0",
    "@sentry/capacitor": "4.4.0",
    "@sentry/react": "10.69.0",
    "axios": "^1.7.0",
    "dayjs": "^1.11.13",
    "emoji-picker-react": "^4.12.0",
    "firebase": "^12.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-quill": "^2.0.0",
    "react-router": "^7.5.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@sentry/vite-plugin": "^5.4.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
