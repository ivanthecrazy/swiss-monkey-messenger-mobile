{
  "name": "swiss-monkey-messenger-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "sync": "npm run build && cap sync",
    "ios": "npm run build && cap sync ios && cap open ios",
    "android": "npm run build && cap sync android && cap open android",
    "assets": "python3 scripts/make-assets.py && npx --yes @capacitor/assets generate --ios --android"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/lato": "^5.1.0",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.1.0",
    "@rails/actioncable": "^8.0.0",
    "@regimenthq/messenger-core": "^0.1.0",
    "@regimenthq/shell-auth": "^0.1.0",
    "axios": "^1.7.0",
    "dayjs": "^1.11.13",
    "emoji-picker-react": "^4.12.0",
    "firebase": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-quill": "^2.0.0",
    "react-router": "^7.5.3"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
